# Copy this file to .env.production, replace every placeholder, and keep it out of Git.
DATABASE_URL=postgresql://moonwitness:REPLACE_ME@postgres.example:5432/moonwitness
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_ACQUIRE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000
JWT_SECRET=
SUPERADMIN_PASSWORD=
METRICS_TOKEN=
WHATSAPP_GATEWAY_URL=https://wa.moonwitness.biz.id
WHATSAPP_GATEWAY_EXPECTED_VERSION=v9.6.0
WHATSAPP_GATEWAY_USERNAME=
WHATSAPP_GATEWAY_PASSWORD=
WHATSAPP_CLAMAV_URL=tcp://clamav:3310
API_PORT=3000
LOG_LEVEL=info
ATTACHMENT_STORAGE_DIR=/var/lib/moonwitness/attachments
# Garage is reached over its public HTTPS S3 API endpoint. ATTACHMENT_S3_REGION must match
# `[s3_api].s3_region` in garage.toml; Garage accepts path-style addressing.
# Provision the app credentials once:
#   garage key create moonwitness-attachments
#   garage bucket create moonwitness-attachments
#   garage bucket allow --read --write moonwitness-attachments --key moonwitness-attachments
ATTACHMENT_STORAGE_DRIVER=s3
ATTACHMENT_S3_ENDPOINT=https://s3.moonwitness.biz.id
ATTACHMENT_S3_REGION=garage
ATTACHMENT_S3_BUCKET=moonwitness-attachments
ATTACHMENT_S3_ACCESS_KEY=
ATTACHMENT_S3_SECRET_KEY=
ATTACHMENT_S3_FORCE_PATH_STYLE=true
# Operator-only Garage endpoints: web console https://s3-web.moonwitness.biz.id, admin API
# https://s3-admin.moonwitness.biz.id. The admin token and RPC secret are not application
# credentials and must not be placed in this file.
# Inject the bucket key pair above from a secret manager, then run
# `pnpm attachments:production-preflight`; it never prints values.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional production handler modules must be present inside the container image.
JOB_HANDLERS_MODULE=
OUTBOX_HANDLERS_MODULE=

# Optional private worker probes; assign distinct ports if all three processes share one host.
WORKER_HEALTH_HOST=127.0.0.1
JOBS_WORKER_HEALTH_PORT=0
JOBS_SCHEDULER_HEALTH_PORT=0
OUTBOX_WORKER_HEALTH_PORT=0

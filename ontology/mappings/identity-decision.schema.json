{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.dev/schemas/identity-decision.schema.json",
  "title": "MoonWitness identity reconciliation candidate and decision",
  "description": "Candidates remain unresolved and never create sameAs relations. Decisions require explicit evidence, reviewer, and review time; conflicts and alias observations are retained.",
  "oneOf": [{ "$ref": "#/$defs/candidate" }, { "$ref": "#/$defs/decision" }],
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "status",
        "left_identity_id",
        "right_identity_id",
        "alias_observations",
        "conflicts",
        "created_at"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^mw:identity-candidate:[a-z0-9][a-z0-9._-]{0,179}$" },
        "kind": { "const": "IdentityReconciliationCandidate" },
        "status": { "const": "candidate" },
        "left_identity_id": { "$ref": "#/$defs/identity_id" },
        "right_identity_id": { "$ref": "#/$defs/identity_id" },
        "alias_observations": { "type": "array", "items": { "$ref": "#/$defs/alias_observation" } },
        "conflicts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/conflict" }
        },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "candidate_id",
        "outcome",
        "evidence_refs",
        "reviewer_id",
        "reviewed_at",
        "preserved_conflict_ids"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^mw:identity-decision:[a-z0-9][a-z0-9._-]{0,179}$" },
        "kind": { "const": "IdentityReconciliationDecision" },
        "candidate_id": {
          "type": "string",
          "pattern": "^mw:identity-candidate:[a-z0-9][a-z0-9._-]{0,179}$"
        },
        "outcome": { "enum": ["accepted", "rejected"] },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "reviewer_id": {
          "type": "string",
          "pattern": "^mw:(?:agent|entity):[a-z0-9][a-z0-9._-]{0,179}$"
        },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "preserved_conflict_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^mw:identity-conflict:[a-z0-9][a-z0-9._-]{0,179}$"
          }
        }
      }
    },
    "identity_id": {
      "type": "string",
      "pattern": "^mw:(?:persona|entity|agent|work|concept):[a-z0-9][a-z0-9._-]{0,179}$"
    },
    "alias_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_id", "label", "language", "script", "context_ref"],
      "properties": {
        "identity_id": { "$ref": "#/$defs/identity_id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 500 },
        "language": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
        "script": { "type": "string", "pattern": "^[A-Z][a-z]{3}$" },
        "context_ref": { "type": "string", "minLength": 1, "maxLength": 500 },
        "meaning_note": { "type": "string", "maxLength": 2000 }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "description", "evidence_refs"],
      "properties": {
        "id": { "type": "string", "pattern": "^mw:identity-conflict:[a-z0-9][a-z0-9._-]{0,179}$" },
        "kind": { "enum": ["homonym", "multilingual_alias", "competing_identity", "other"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonwitness.dev/ontology/domains/story-version.schema.json",
  "title": "MoonWitness versioned story",
  "description": "A versioned story snapshot with verbatim page text. The storage layer must keep pages in ascending page_order with unique contiguous one-based values from 1 through N; JSON Schema cannot enforce cross-item order or uniqueness by page_order. Each page may refer to at most one immutable media artifact. Visibility is fixed to INTERNAL; this contract has no publication controls.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "story_id", "version", "title", "visibility", "pages"],
  "properties": {
    "schema_version": { "const": 1 },
    "story_id": { "type": "string", "pattern": "^mw:story:[a-z0-9][a-z0-9._-]{0,179}$" },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "visibility": { "const": "INTERNAL" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_id", "page_order", "original_text"],
      "properties": {
        "page_id": { "type": "string", "pattern": "^mw:story-page:[a-z0-9][a-z0-9._-]{0,179}$" },
        "page_order": { "type": "integer", "minimum": 1 },
        "original_text": { "type": "string", "minLength": 1, "maxLength": 1000000 },
        "media": { "$ref": "#/$defs/media" }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256", "media_type", "rights_ref"],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^mw:artifact:[a-z0-9][a-z0-9._-]{0,179}$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "media_type": {
          "type": "string",
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+(?:\\s*;\\s*[A-Za-z0-9!#$&^_.+-]+=(?:[A-Za-z0-9!#$&^_.+-]+|\"[^\"]*\"))*$"
        },
        "rights_ref": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}

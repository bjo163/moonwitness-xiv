{
  "name": "@moonwitness/orm-storage",
  "version": "1.0.0-rc.1",
  "description": "Typed storage providers and attachment lifecycle utilities for MoonWitness",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc -p tsconfig.check.json && vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/lib-storage": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@moonwitness/orm": "workspace:*",
    "@moonwitness/types": "workspace:*",
    "@smithy/node-http-handler": "^4.12.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "~5.7.3",
    "vitest": "5.0.3"
  }
}

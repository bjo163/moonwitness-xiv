{
  "name": "@moonwitness/knowledge",
  "version": "1.0.0-rc.1",
  "description": "Offline typed core knowledge record contracts and validation",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./schema": "./dist/schemas/knowledge-record.schema.json",
    "./provenance-schema": "./dist/schemas/provenance-graph.schema.json",
    "./source-artifact-schema": "./dist/schemas/source-artifact-manifest.schema.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "~5.7.3",
    "vitest": "^5.0.3"
  }
}

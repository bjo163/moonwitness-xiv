    "./fonts.css": "./fonts.css",
    "./icons/*": "./icons/*",
    "./illustrations/*": "./illustrations/*",
    "./sounds/*": "./sounds/*",
    "./manifest.json": "./manifest.json",
    "./licenses.json": "./licenses.json"
  },
  "devDependencies": {
    "opentype.js": "^2.0.0",
    "sharp": "0.35.5",
    "subset-font": "^2.9.0"
  }

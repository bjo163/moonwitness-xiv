{
  "name": "@moonwitness/assets",
  "version": "1.0.0-rc.1",
  "description": "Framework-independent MoonWitness brand and visual assets",
  "type": "module",
  "license": "ISC",
  "scripts": {
    "brand:prepare": "node scripts/prepare-brand-master.mjs",
    "fonts:prepare": "node scripts/prepare-fonts.mjs",
    "artwork:prepare": "node scripts/prepare-artwork.mjs"
  },
  "files": [
    "brand",
    "fonts",
    "fonts.css",
    "icons",
    "illustrations",
    "sounds",
    "manifest.json",
    "licenses.json",
    "README.md"

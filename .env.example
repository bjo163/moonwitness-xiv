NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000

# Optional local AI runtime. Disabled by default; no remote fallback is supported.
AI_MODE=disabled
# Required only when AI_MODE=local; loopback HTTP endpoint, e.g. http://127.0.0.1:11434
# LOCAL_AI_ENDPOINT=http://127.0.0.1:11434
# LOCAL_AI_TIMEOUT_MS=15000

# Initial superadmin password; stored as a hash and only applied when unset.
SUPERADMIN_PASSWORD=

# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/moonwitness_db

# PostgreSQL resource bounds (applied per API/worker process).
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_ACQUIRE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000

# Writable shared directory for uploaded attachments (10 MiB maximum per file).
ATTACHMENT_STORAGE_DIR=storage/attachments
ATTACHMENT_STORAGE_DRIVER=local
# Set driver=s3 to store attachments in the private Garage bucket. API and every worker must
# share this config. Garage S3 API endpoint: https://s3.moonwitness.biz.id
# ATTACHMENT_S3_REGION must match [s3_api].s3_region in garage.toml (commonly `garage`);
# Garage accepts path-style S3 requests.
# Provision once per environment:
#   garage key create moonwitness-attachments
#   garage bucket create moonwitness-attachments
#   garage bucket allow --read --write moonwitness-attachments --key moonwitness-attachments
# ATTACHMENT_STORAGE_DRIVER=s3
# ATTACHMENT_S3_ENDPOINT=https://s3.moonwitness.biz.id
# ATTACHMENT_S3_REGION=garage
# ATTACHMENT_S3_BUCKET=moonwitness-attachments
# ATTACHMENT_S3_ACCESS_KEY=<access key Garage>
# ATTACHMENT_S3_SECRET_KEY=
# ATTACHMENT_S3_FORCE_PATH_STYLE=true
# The Garage web console (https://s3-web.moonwitness.biz.id), admin API
# (https://s3-admin.moonwitness.biz.id), admin token and RPC secret are operator-only and are
# never attachment-storage credentials.

# Logging
LOG_LEVEL=info
LOG_DIR=logs
LOG_FILE_NAME=api.log
# Empty selects environment defaults (file/pretty in development, stdout JSON in production).
LOG_TO_FILE=
LOG_PRETTY=

# Print the registered route tree on startup
PRINT_ROUTES=true

# Authentication & JWT
# Required in every environment; use a persistent random value (at least 32 characters).
# Generate with: node --input-type=module -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
AUTH_LOGIN_RATE_MAX=10

# Enables authenticated Prometheus metrics at /metrics; use a random value of 32+ chars.
METRICS_TOKEN=

# Hosted GoWA gateway. Override this only when using another GoWA instance.
WHATSAPP_GATEWAY_URL=https://wa.moonwitness.biz.id
WHATSAPP_GATEWAY_EXPECTED_VERSION=v9.6.0
WHATSAPP_GATEWAY_USERNAME=moonwitness
WHATSAPP_GATEWAY_PASSWORD=moonwitness
WHATSAPP_GATEWAY_TIMEOUT_MS=20000
# ClamAV clamd endpoint. Start the default Docker Compose stack for the local scanner.
WHATSAPP_CLAMAV_URL=tcp://127.0.0.1:3310
# Optional path to ffmpeg used to create video preview posters (install ffmpeg for local API runs).
WHATSAPP_FFMPEG_PATH=ffmpeg
# Optional: public HTTPS origin of this API. GoWA posts message and message.ack events here.
# Configure both values to enable provider receipts; use a random secret with at least 32 characters.
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_SECRET=
# Set this when running the optional live GoWA contract test.
WHATSAPP_GATEWAY_EXPECTED_VERSION=v9.6.0
JOB_HANDLERS_MODULE=
OUTBOX_HANDLERS_MODULE=

# Standalone Board started by pnpm start; API and Board must use different ports.
BOARD_PORT=5173
BOARD_HOST=127.0.0.1

# Optional worker probes. Set OUTBOX_WORKER_HEALTH_PORT above 0 to expose authenticated worker metrics;
# set WORKER_HEALTH_HOST to a private-network interface only when a scraper must reach the container.
WORKER_HEALTH_HOST=127.0.0.1
JOBS_WORKER_HEALTH_PORT=0
JOBS_SCHEDULER_HEALTH_PORT=0
OUTBOX_WORKER_HEALTH_PORT=0

# Authenticated attachments use persistent local storage by default; keep this directory shared
# between API replicas connected to the same database.
ATTACHMENT_STORAGE_DIR=storage/attachments

# Optional: enables PostgreSQL-only integration tests (tests create/drop an isolated schema).
# POSTGRES_TEST_URL=postgresql://postgres:postgres@127.0.0.1:5432/moonwitness_test

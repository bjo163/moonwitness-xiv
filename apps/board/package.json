{
  "name": "@moonwitness/board",
  "private": true,
  "version": "1.0.0-rc.1",
  "description": "MoonWitness admin board: data-driven views rendered from API metadata",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/copy-board-public-assets.mjs && next dev -p 5173",
    "build": "node ../../scripts/copy-board-public-assets.mjs && next build",
    "start": "node ../../scripts/prepare-board-standalone.mjs && node ../../scripts/start-board.mjs",
    "start:built": "node ../../scripts/prepare-board-standalone.mjs && node ../../scripts/start-board.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "preview": "node ../../scripts/prepare-board-standalone.mjs && node .next/standalone/apps/board/server.js"
  },
  "dependencies": {
    "@moonwitness/assets": "workspace:*",
    "@moonwitness/client": "workspace:*",
    "@moonwitness/types": "workspace:*",
    "@moonwitness/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "qrcode": "^1.5.4",
    "next": "^16.4.2",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.7.3"
  }
}
